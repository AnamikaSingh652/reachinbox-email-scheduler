generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  scheduled
  processing
  sent
  failed
  cancelled
}

model User {
  id               String            @id @default(uuid())
  googleId         String            @unique
  name             String
  email            String            @unique
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  senders          Sender[]
  campaigns        EmailCampaign[]
  scheduledEmails  ScheduledEmail[]
  slackConnection  SlackConnection?
  idempotencyKeys  IdempotencyKey[]

  @@map("users")
}

model Sender {
  id               String            @id @default(uuid())
  userId           String
  name             String
  email            String
  etherealUser     String
  etherealPassword String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns        EmailCampaign[]
  scheduledEmails  ScheduledEmail[]

  @@map("senders")
}

model EmailCampaign {
  id                 String           @id @default(uuid())
  userId             String
  senderId           String
  subject            String
  body               String
  startTime          DateTime
  delayBetweenEmails Int              @default(2000)
  hourlyLimit        Int              @default(200)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender             Sender           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  scheduledEmails    ScheduledEmail[]

  @@map("email_campaigns")
}

model ScheduledEmail {
  id                 String          @id @default(uuid())
  campaignId         String?
  userId             String
  senderId           String
  recipient          String
  subject            String
  body               String
  scheduledAt        DateTime
  status             EmailStatus     @default(scheduled)
  bullJobId          String?
  attempts           Int             @default(0)
  lastError          String?
  sentAt             DateTime?
  etherealMessageId  String?
  etherealPreviewUrl String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender             Sender          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  campaign           EmailCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([senderId, status])
  @@index([scheduledAt])
  @@index([bullJobId])
  @@map("scheduled_emails")
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  teamId      String
  teamName    String
  accessToken String
  channelId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("slack_connections")
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  key         String   @unique
  userId      String
  requestHash String
  response    Json
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("idempotency_keys")
}
